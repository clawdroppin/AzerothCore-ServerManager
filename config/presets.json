          "Battleground.CastDeserter": "0", "Battleground.QueueAnnouncer.Enable": "1", "Battleground.GiveXPForKills": "1",
          "Battleground.PrepTime": "30", "DurabilityLoss.InPvP": "0", "Rate.ArenaPoints": "2"
        },
        "modules/playerbots.conf": { "AiPlayerbot.RandomBotJoinBG": "1" }
      }
    },
    {
      "id": "together", "icon": "🤝", "name": "Friends & family",
      "tagline": "Horde and Alliance play together.",
      "description": "Group, guild, chat, trade on one auction house and use the calendar across factions, so everyone can play together whatever they picked. Instant mail and double rested XP.",
      "settings": {},
      "overrides": {
        "worldserver.conf": {
          "AllowTwoSide.Interaction.Group": "1", "AllowTwoSide.Interaction.Guild": "1", "AllowTwoSide.Interaction.Chat": "1",
          "AllowTwoSide.Interaction.Channel": "1", "AllowTwoSide.Interaction.Auction": "1", "AllowTwoSide.Interaction.Calendar": "1",
          "AllowTwoSide.Interaction.Arena": "1", "AllowTwoSide.Accounts": "1",
          "MailDeliveryDelay": "0",
          "Rate.Rest.InGame": "2", "Rate.Rest.Offline.InTavernOrCity": "2", "Rate.Rest.Offline.InWilderness": "2"
        }
      }
    },
    {
      "id": "laptop", "icon": "🔋", "name": "Laptop mode",
      "tagline": "Lighter on CPU and memory.",
      "description": "Half the bots, fewer bots busy far away from you, a shorter view distance and a gentler startup. Good for laptops and older PCs.",
      "settings": { "botsFactor": 0.5 },
      "overrides": {
        "worldserver.conf": { "Visibility.Distance.Continents": "70" },
        "modules/playerbots.conf": { "AiPlayerbot.BotActiveAlone": "5", "AiPlayerbot.botActiveAloneSmartScale": "1", "AiPlayerbot.RandomBotsPerInterval": "30" }
      }
    }
