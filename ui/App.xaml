<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AzerothCore Control Center" Width="1240" Height="820" MinWidth="1020" MinHeight="660"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="14" TextOptions.TextFormattingMode="Display">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="236"/>
      <ColumnDefinition/>
    </Grid.ColumnDefinitions>

    <!-- ===================================================== SIDEBAR -->
    <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="22,22,22,10">
          <TextBlock Text="AZEROTHCORE" Foreground="{StaticResource AccentBrush}" FontSize="19" FontWeight="Bold" />
          <TextBlock Text="Control Center" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="1,0,0,0"/>
        </StackPanel>

        <RadioButton x:Name="NavServers" DockPanel.Dock="Top" Style="{StaticResource Nav}" Content="⌂  My servers" Margin="0,4,0,0"/>

        <StackPanel DockPanel.Dock="Top" Margin="20,12,20,6">
          <TextBlock Text="SELECTED SERVER" Style="{StaticResource StatLabel}" Margin="0,0,0,4"/>
          <ComboBox x:Name="CmbServer"/>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusText" Text="Unknown" Margin="7,0,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
          </StackPanel>
          <Button x:Name="BtnBgTask" Visibility="Collapsed" Margin="0,8,0,0" Padding="8,4" FontSize="12" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Left" ToolTip="Show the progress"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,14">
          <Border Height="1" Background="{StaticResource BorderBrush}" Margin="20,0,20,8"/>
          <RadioButton x:Name="NavNew" Style="{StaticResource Nav}" Content="＋  New server"/>
          <RadioButton x:Name="NavImport" Style="{StaticResource Nav}" Content="⇩  Import a server"/>
          <RadioButton x:Name="NavPrereqs" Style="{StaticResource Nav}" Content="☑  Prerequisites"/>
          <RadioButton x:Name="NavAbout" Style="{StaticResource Nav}" Content="ⓘ  Help &amp; about"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
          <StackPanel x:Name="NavPanel">
            <RadioButton x:Name="NavDashboard" Style="{StaticResource Nav}" Content="◆  Dashboard"/>
            <RadioButton x:Name="NavConsole" Style="{StaticResource Nav}" Content="›_  Console"/>
            <RadioButton x:Name="NavAccounts" Style="{StaticResource Nav}" Content="☺  Accounts"/>
            <RadioButton x:Name="NavCharacters" Style="{StaticResource Nav}" Content="⚔  Characters &amp; bots"/>
            <RadioButton x:Name="NavFriends" Style="{StaticResource Nav}" Content="♥  Play with friends"/>
            <RadioButton x:Name="NavAi" Style="{StaticResource Nav}" Content="✦  AI chatter"/>
            <RadioButton x:Name="NavSettings" Style="{StaticResource Nav}" Content="⚙  World settings"/>
            <RadioButton x:Name="NavAddons" Style="{StaticResource Nav}" Content="✚  Game addons"/>
            <RadioButton x:Name="NavBackups" Style="{StaticResource Nav}" Content="⛁  Backups &amp; schedules"/>
            <RadioButton x:Name="NavExport" Style="{StaticResource Nav}" Content="⇪  Export &amp; move"/>
            <RadioButton x:Name="NavUpdates" Style="{StaticResource Nav}" Content="⟳  Updates"/>
            <RadioButton x:Name="NavPerformance" Style="{StaticResource Nav}" Content="▤  Performance"/>
            <RadioButton x:Name="NavLogs" Style="{StaticResource Nav}" Content="☰  Logs"/>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- ===================================================== PAGES -->
    <Grid Grid.Column="1" x:Name="PageHost" Margin="30,24,30,18">

      <!-- ................................................. WELCOME (no servers yet) -->
      <StackPanel x:Name="PageWelcome" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="620" Visibility="Collapsed">
        <TextBlock Text="Welcome, adventurer" Style="{StaticResource H1}" FontSize="32" HorizontalAlignment="Center"/>
        <TextBlock Style="{StaticResource Muted}" FontSize="15" TextAlignment="Center" Margin="0,6,0,24"
                   Text="Build your own World of Warcraft 3.3.5a server full of AI players, then run it from here: start and stop it, manage accounts, invite friends, back it up and keep it updated."/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <Button x:Name="BtnWelcomeCreate" Style="{StaticResource Primary}" Content="Create a new server" Padding="22,12" FontSize="15"/>
          <Button x:Name="BtnWelcomeAdd" Content="I already have one" Padding="22,12" FontSize="15"/>
        </StackPanel>
      </StackPanel>

      <!-- ................................................. DASHBOARD -->
      <ScrollViewer x:Name="PageDashboard" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
        <StackPanel>
          <DockPanel Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="BtnStart" Style="{StaticResource Primary}" Content="▶  Start server"/>
              <Button x:Name="BtnRestart" Content="⟳  Restart"/>
              <Button x:Name="BtnStop" Style="{StaticResource Danger}" Content="■  Stop" Margin="0"/>
            </StackPanel>
            <StackPanel>
              <TextBlock x:Name="DashTitle" Style="{StaticResource H1}" Text="Dashboard"/>
              <TextBlock x:Name="DashSubtitle" Style="{StaticResource Muted}"/>
            </StackPanel>
          </DockPanel>

          <UniformGrid Columns="4" Margin="-7,0,-7,0">
            <Border Style="{StaticResource Card}" Margin="7,0,7,14">
              <StackPanel><TextBlock Style="{StaticResource StatLabel}" Text="REAL PLAYERS ONLINE"/><TextBlock x:Name="StatPlayers" Style="{StaticResource StatValue}" Text="–"/></StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="7,0,7,14">
              <StackPanel><TextBlock Style="{StaticResource StatLabel}" Text="BOTS ONLINE"/><TextBlock x:Name="StatBots" Style="{StaticResource StatValue}" Text="–"/></StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="7,0,7,14">
              <StackPanel><TextBlock Style="{StaticResource StatLabel}" Text="SERVER SPEED (TICK)"/><TextBlock x:Name="StatTick" Style="{StaticResource StatValue}" Text="–"/><TextBlock x:Name="StatTickHint" Style="{StaticResource Muted}" FontSize="11"/></StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="7,0,7,14">
              <StackPanel><TextBlock Style="{StaticResource StatLabel}" Text="UPTIME / MEMORY"/><TextBlock x:Name="StatUptime" Style="{StaticResource StatValue}" Text="–"/><TextBlock x:Name="StatRam" Style="{StaticResource Muted}" FontSize="11"/></StackPanel>
            </Border>
          </UniformGrid>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <DockPanel>
                <Button x:Name="BtnRepair" DockPanel.Dock="Right" Content="🛠  Check &amp; repair..." Margin="0" VerticalAlignment="Top"
                        ToolTip="Looks for the usual ways a server breaks (moved folders, missing files, database problems...) and repairs them"/>
                <TextBlock Style="{StaticResource H2}" Text="Health check"/>
              </DockPanel>
              <ItemsControl x:Name="HealthList"/>
            </StackPanel>
          </Border>

          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource H2}" Text="Services"/>
                <ItemsControl x:Name="ServiceList"/>
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource H2}" Text="Quick actions"/>
                <WrapPanel>
                  <Button x:Name="QaSave" Content="💾 Save all characters" Margin="0,0,8,8"/>
                  <Button x:Name="QaAnnounce" Content="📢 Announce message" Margin="0,0,8,8"/>
                  <Button x:Name="QaMotd" Content="✉ Message of the day" Margin="0,0,8,8"/>
                  <Button x:Name="QaGame" Content="🎮 Launch WoW" Margin="0,0,8,8"/>
                  <Button x:Name="QaFolder" Content="📁 Open server folder" Margin="0,0,8,8"/>
                  <Button x:Name="QaBackup" Content="⛁ Back up now" Margin="0,0,8,8"/>
                </WrapPanel>
                <CheckBox x:Name="ChkAutostart" Margin="0,8,0,0" Content="Start this server automatically when I sign in to Windows"/>
              </StackPanel>
            </Border>
          </Grid>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <DockPanel>
                <TextBlock x:Name="SparkLabel" DockPanel.Dock="Right" Style="{StaticResource Muted}"/>
                <TextBlock Style="{StaticResource H2}" Text="Server speed (lower is smoother)"/>
              </DockPanel>
              <Border Height="90" Background="#151821" CornerRadius="6" ClipToBounds="True">
                <Canvas x:Name="SparkCanvas">
                  <Polyline x:Name="SparkLine" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" StrokeLineJoin="Round"/>
                </Canvas>
              </Border>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource H2}" Text="Bot population by level"/>
              <ItemsControl x:Name="LevelChart"/>
              <TextBlock x:Name="LevelChartHint" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- ................................................. CONSOLE -->
      <DockPanel x:Name="PageConsole" Visibility="Collapsed">
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Style="{StaticResource H1}" Text="Console"/>
          <TextBlock Style="{StaticResource Muted}" Text="Run Game Master commands on the live server (no dot needed). The server must be running." Margin="0,0,0,12"/>
          <WrapPanel x:Name="QuickCommands" Margin="0,0,0,8"/>
        </StackPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
          <Button x:Name="BtnRunCmd" DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Run" Margin="8,0,0,0"/>
          <TextBox x:Name="TxtCmd" FontFamily="Consolas" FontSize="14"/>
        </DockPanel>
        <TextBox x:Name="ConsoleOut" IsReadOnly="True" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" Background="#0D0F14"/>
      </DockPanel>

      <!-- ................................................. ACCOUNTS -->
      <DockPanel x:Name="PageAccounts" Visibility="Collapsed">
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Style="{StaticResource H1}" Text="Accounts"/>
          <TextBlock Style="{StaticResource Muted}" Text="Logins for you, friends and alts. Bot accounts are hidden." Margin="0,0,0,12"/>
          <Border Style="{StaticResource Card}">
            <WrapPanel>
              <TextBlock Text="Username" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBox x:Name="AccUser" Width="150" MaxLength="17" Margin="0,0,14,0"/>
              <TextBlock Text="Password" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <PasswordBox x:Name="AccPass" Width="150" MaxLength="16" Margin="0,0,14,0"/>
              <ComboBox x:Name="AccLevel" Width="170" Margin="0,0,14,0">
                <ComboBoxItem Content="Player" IsSelected="True"/>
                <ComboBoxItem Content="Moderator (GM 1)"/>
                <ComboBoxItem Content="Game Master (GM 2)"/>
                <ComboBoxItem Content="Administrator (GM 3)"/>
              </ComboBox>
              <Button x:Name="BtnAccCreate" Style="{StaticResource Primary}" Content="Create / reset password"/>
            </WrapPanel>
          </Border>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
          <Button x:Name="BtnAccRefresh" Content="Refresh"/>
          <Button x:Name="BtnAccGm" Content="Set GM level from box above"/>
          <Button x:Name="BtnAccBan" Content="Ban / unban"/>
          <Button x:Name="BtnAccDelete" Style="{StaticResource Danger}" Content="Delete account"/>
        </StackPanel>
        <DataGrid x:Name="AccGrid">
          <DataGrid.Columns>
            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
            <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="2*"/>
            <DataGridTextColumn Header="GM level" Binding="{Binding GmLevel}" Width="80"/>
            <DataGridTextColumn Header="Characters" Binding="{Binding Characters}" Width="90"/>
            <DataGridCheckBoxColumn Header="Online" Binding="{Binding Online}" Width="70"/>
            <DataGridCheckBoxColumn Header="Banned" Binding="{Binding Banned}" Width="70"/>
            <DataGridTextColumn Header="Last login" Binding="{Binding LastLogin}" Width="2*"/>
            <DataGridTextColumn Header="Last IP" Binding="{Binding LastIp}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>

      <!-- ................................................. CHARACTERS -->
      <DockPanel x:Name="PageCharacters" Visibility="Collapsed">
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Style="{StaticResource H1}" Text="Characters &amp; bots"/>
          <WrapPanel Margin="0,4,0,12">
            <ComboBox x:Name="CharKind" Width="180" Margin="0,0,10,0">
              <ComboBoxItem Content="Real players" IsSelected="True"/>
              <ComboBoxItem Content="Bots"/>
              <ComboBoxItem Content="Everyone"/>
            </ComboBox>
            <CheckBox x:Name="CharOnline" Content="Online only" VerticalAlignment="Center" Margin="0,0,14,0"/>
            <Button x:Name="BtnCharRefresh" Content="Refresh"/>
            <Button x:Name="BtnCharKick" Content="Kick"/>
            <Button x:Name="BtnCharSummon" Content="Teleport to..."/>
            <Button x:Name="BtnCharLevel" Content="Set level..."/>
            <Button x:Name="BtnCharGold" Content="Mail gold..."/>
            <Button x:Name="BtnCharItem" Content="Mail item..."/>
            <Button x:Name="BtnCharCopy" Content="Copy to another server..."/>
          </WrapPanel>
        </StackPanel>
        <TextBlock x:Name="CharCount" DockPanel.Dock="Bottom" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
        <DataGrid x:Name="CharGrid">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
            <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="60"/>
            <DataGridTextColumn Header="Race" Binding="{Binding Race}" Width="*"/>
            <DataGridTextColumn Header="Class" Binding="{Binding Class}" Width="*"/>
            <DataGridCheckBoxColumn Header="Online" Binding="{Binding Online}" Width="70"/>
            <DataGridTextColumn Header="Gold" Binding="{Binding Money}" Width="80"/>
            <DataGridTextColumn Header="Played" Binding="{Binding PlayedSec}" Width="80"/>
            <DataGridTextColumn Header="Account" Binding="{Binding Account}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>

      <!-- ................................................. FRIENDS -->
      <ScrollViewer x:Name="PageFriends" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
        <StackPanel>
          <TextBlock Style="{StaticResource H1}" Text="Play with friends"/>
          <TextBlock Style="{StaticResource Muted}" Text="Let other people (a partner, family, friends) join your world. Pick how they will connect." Margin="0,0,0,14"/>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource H2}" Text="Your network"/>
              <TextBlock x:Name="NetInfo" TextWrapping="Wrap" LineHeight="22"/>
              <Button x:Name="BtnNetRefresh" Content="Detect again" HorizontalAlignment="Left" Margin="0,10,0,0"/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource H2}" Text="1 · Choose how friends connect"/>
              <RadioButton x:Name="RbNetLocal" GroupName="NetMode" Content="Only me (this PC)"/>
              <RadioButton x:Name="RbNetLan" GroupName="NetMode" Content="Same home network (Wi-Fi / cable in the same house) - easiest"/>
              <RadioButton x:Name="RbNetVpn" GroupName="NetMode" Content="Over the internet with a free VPN (Tailscale) - recommended for internet play, no router setup"/>
              <RadioButton x:Name="RbNetInternet" GroupName="NetMode" Content="Over the internet with port forwarding (advanced, needs router access)"/>
              <TextBlock x:Name="NetModeHelp" Style="{StaticResource Muted}" Margin="22,8,0,0" LineHeight="20"/>
              <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button x:Name="BtnNetApply" Style="{StaticResource Primary}" Content="Apply connection mode"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource H2}" Text="2 · Windows Firewall"/>
              <TextBlock Style="{StaticResource Muted}" Text="Other computers can only reach the server if Windows Firewall lets them in on ports 3724 (login) and 8085 (game). Click the button to add exactly those two rules (you can remove them again here)."/>
              <TextBlock x:Name="FwStatus" Margin="0,8,0,0"/>
              <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="BtnFwOn" Content="Allow friends through the firewall"/>
                <Button x:Name="BtnFwOff" Content="Remove the firewall rules"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource H2}" Text="3 · Give your friend what they need"/>
              <TextBlock Style="{StaticResource Muted}" Text="Creates an account for your friend and a small folder with their realmlist file and step-by-step instructions you can send them."/>
              <WrapPanel Margin="0,10,0,0">
                <TextBlock Text="Their username" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="FriendUser" Width="150" MaxLength="17" Margin="0,0,14,0"/>
                <TextBlock Text="Their password" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="FriendPass" Width="150" MaxLength="16" Margin="0,0,14,0"/>
                <Button x:Name="BtnFriendKit" Style="{StaticResource Primary}" Content="Create account + join kit"/>
              </WrapPanel>
              <TextBlock x:Name="FriendResult" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource H2}" Text="4 · Discord notifications (optional)"/>
              <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                         Text="Post to a Discord channel when the server comes online or goes offline, when a friend logs in, if it crashes, and about updates. In Discord: Server Settings > Integrations > Webhooks > New Webhook > Copy Webhook URL, then paste it here."/>
              <DockPanel Margin="0,10,0,0">
                <TextBlock Text="Webhook URL" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="TxtDiscord"/>
              </DockPanel>
              <WrapPanel Margin="0,8,0,0">
                <CheckBox x:Name="ChkNotifyStart" Content="Online / offline" Margin="0,0,16,0"/>
                <CheckBox x:Name="ChkNotifyLogin" Content="A player logs in" Margin="0,0,16,0"/>
                <CheckBox x:Name="ChkNotifyCrash" Content="Crashes" Margin="0,0,16,0"/>
                <CheckBox x:Name="ChkNotifyUpdate" Content="Updates" Margin="0,0,16,0"/>
              </WrapPanel>
              <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="BtnDiscordSave" Style="{StaticResource Primary}" Content="Save"/>
                <Button x:Name="BtnDiscordTest" Content="Send a test message"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource H2}" Text="Port forwarding guide (only for the advanced option)"/>
              <TextBlock x:Name="PortGuide" Style="{StaticResource Muted}" FontSize="13" LineHeight="21"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- ................................................. AI -->
      <ScrollViewer x:Name="PageAi" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
        <StackPanel>
          <TextBlock Style="{StaticResource H1}" Text="AI chatter"/>
          <TextBlock Style="{StaticResource Muted}" Text="Bots talk in party, say and general chat using a local AI model through Ollama." Margin="0,0,0,14"/>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource H2}" Text="Model"/>
              <TextBlock x:Name="AiStatus" Margin="0,0,0,10" TextWrapping="Wrap"/>
              <CheckBox x:Name="ChkAiEnabled" Content="AI chatter enabled"/>
              <WrapPanel Margin="0,8,0,0">
                <TextBlock Text="Use model" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="AiModel" Width="300" Margin="0,0,10,0" IsEditable="False"/>
                <Button x:Name="BtnAiTest" Content="Test it"/>
              </WrapPanel>
              <WrapPanel Margin="0,10,0,0">
                <TextBlock Text="How chatty" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="AiPreset" Width="300" Margin="0,0,10,0">
                  <ComboBoxItem Content="Chatty (default)" Tag="default"/>
                  <ComboBoxItem Content="Quieter" Tag="quieter"/>
                </ComboBox>
              </WrapPanel>
              <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <Button x:Name="BtnAiSave" Style="{StaticResource Primary}" Content="Save (applies on next server start)"/>
              </StackPanel>
              <TextBlock x:Name="AiTestResult" Margin="0,12,0,0" TextWrapping="Wrap" FontStyle="Italic"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource H2}" Text="Download another model"/>
              <TextBlock Style="{StaticResource Muted}" Text="Bigger models write better but need more graphics memory. Close other AI apps while playing so the model fits on the graphics card."/>
              <WrapPanel Margin="0,10,0,0">
                <ComboBox x:Name="AiCatalog" Width="420" Margin="0,0,10,0"/>
                <Button x:Name="BtnAiPull" Content="Download"/>
              </WrapPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- ................................................. SETTINGS -->
      <DockPanel x:Name="PageSettings" Visibility="Collapsed">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="BtnSetExtras" Content="✦  Extra settings" ToolTip="Dozens more options: flights, starting gold, death penalty, cross-faction play, monster difficulty, bot behaviour..."/>
            <Button x:Name="BtnSetPresets" Content="★  Presets" Margin="0" ToolTip="One-click styles of play: Blizzlike, Fast &amp; fun, Hardcore, Instant endgame..."/>
          </StackPanel>
          <StackPanel>
            <TextBlock Style="{StaticResource H1}" Text="World settings"/>
            <TextBlock x:Name="SetSubtitle" Style="{StaticResource Muted}" Text="Changes are applied to the server's config files and take effect after a restart."/>
          </StackPanel>
        </DockPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
          <Button x:Name="BtnSetAllOptions" DockPanel.Dock="Right" Content="All options (advanced)..." Margin="0"
                  ToolTip="Every option of every server file, with the developers' descriptions"/>
          <StackPanel Orientation="Horizontal">
            <Button x:Name="BtnSetSave" Style="{StaticResource Primary}" Content="Save settings"/>
            <Button x:Name="BtnSetSaveRestart" Content="Save and restart server"/>
            <Button x:Name="BtnSetOpenConf" Content="Open config folder"/>
          </StackPanel>
        </DockPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="SettingsForm"/>
        </ScrollViewer>
      </DockPanel>

      <!-- ................................................. BACKUPS -->
      <ScrollViewer x:Name="PageBackups" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
        <StackPanel>
          <TextBlock Style="{StaticResource H1}" Text="Backups &amp; schedules"/>
          <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12" TextWrapping="Wrap"
                     Text="Backups hold all accounts, characters and bot data. A save point also includes the world and your settings: make one before experimenting, and go back to it with one click."/>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <WrapPanel Margin="0,0,0,12">
                <Button x:Name="BtnBackupNow" Style="{StaticResource Primary}" Content="Back up now"/>
                <Button x:Name="BtnSavePoint" Content="★ Create a save point (everything)" ToolTip="Characters, bots, the world and all settings - restore it to undo an experiment"/>
              </WrapPanel>
              <WrapPanel>
                <CheckBox x:Name="ChkBackupDaily" Content="Back up every day at" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="TxtBackupTime" Width="70" Text="05:00" Margin="0,0,14,0"/>
                <TextBlock Text="Keep the newest" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="TxtBackupKeep" Width="50" Margin="0,0,6,0"/>
                <TextBlock Text="backups" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <Button x:Name="BtnBackupSchedule" Content="Save schedule"/>
              </WrapPanel>
              <DockPanel Margin="0,12,0,0">
                <TextBlock Text="Also keep a copy in" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button x:Name="BtnBackupCopyClear" DockPanel.Dock="Right" Content="Don't copy" Margin="8,0,0,0"/>
                <Button x:Name="BtnBackupCopyDir" DockPanel.Dock="Right" Content="Choose folder..." Margin="8,0,0,0"/>
                <TextBox x:Name="TxtBackupCopy" IsReadOnly="True" ToolTip="Another drive, a USB disk or a cloud-synced folder (OneDrive, Google Drive, Dropbox...)"/>
              </DockPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource H2}" Text="Daily restart"/>
              <TextBlock Style="{StaticResource Muted}" Text="A daily restart keeps a busy server fresh. Players get an in-game warning first; nothing happens if the server is off." Margin="0,0,0,8"/>
              <WrapPanel>
                <CheckBox x:Name="ChkRestartDaily" Content="Restart every day at" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="TxtRestartTime" Width="70" Text="06:00" Margin="0,0,14,0"/>
                <TextBlock Text="warning" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="TxtRestartWarn" Width="50" Text="5" Margin="0,0,6,0"/>
                <TextBlock Text="minutes before" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <Button x:Name="BtnRestartSchedule" Content="Save"/>
              </WrapPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <Button x:Name="BtnEventAdd" Content="＋ Add event"/>
                  <Button x:Name="BtnEventSave" Style="{StaticResource Primary}" Content="Save events" Margin="0"/>
                </StackPanel>
                <TextBlock Style="{StaticResource H2}" Text="Events"/>
              </DockPanel>
              <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                         Text="Bonus times that switch on and off by themselves, like a double XP weekend. Players get an announcement when one starts and ends; no restart needed."/>
              <StackPanel x:Name="EventList"/>
              <TextBlock x:Name="EventStatus" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource H2}" Text="Your backups"/>
              <DataGrid x:Name="BackupGrid" MaxHeight="300">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Backup" Binding="{Binding Name}" Width="3*"/>
                  <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="2*"/>
                  <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="2*"/>
                  <DataGridTextColumn Header="Size (MB)" Binding="{Binding SizeMB}" Width="*"/>
                </DataGrid.Columns>
              </DataGrid>
              <WrapPanel Margin="0,10,0,0">
                <Button x:Name="BtnBackupRefresh" Content="Refresh"/>
                <Button x:Name="BtnBackupOpen" Content="Open backups folder"/>
                <Button x:Name="BtnBackupDelete" Content="Delete selected"/>
                <Button x:Name="BtnBackupRestore" Style="{StaticResource Danger}" Content="Restore selected backup..."/>
              </WrapPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- ................................................. UPDATES -->
      <ScrollViewer x:Name="PageUpdates" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
        <StackPanel>
          <TextBlock Style="{StaticResource H1}" Text="Updates"/>
          <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12" TextWrapping="Wrap"
                     Text="Safe updates: the new version compiles while your server keeps running. Then the server restarts once, a complete safety copy is made, and the new version is checked - if anything is wrong, everything is put back automatically."/>
          <Border x:Name="UpdNotice" Style="{StaticResource Card}" Background="#2B2516" BorderBrush="#6B5A2A" Visibility="Collapsed">
            <DockPanel>
              <Button x:Name="BtnUpdNotice" DockPanel.Dock="Right" Content="OK" VerticalAlignment="Center" Margin="12,0,0,0"/>
              <TextBlock x:Name="UpdNoticeText" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <Button x:Name="BtnUpdCheck" Content="Check for updates"/>
                  <Button x:Name="BtnUpdApply" Style="{StaticResource Primary}" Content="Update selected" Margin="0"/>
                </StackPanel>
                <TextBlock Style="{StaticResource H2}" Text="What's new"/>
              </DockPanel>
              <TextBlock x:Name="UpdSummary" Margin="0,0,0,8" TextWrapping="Wrap"/>
              <StackPanel x:Name="UpdNoSource" Visibility="Collapsed" Margin="0,0,0,8">
                <TextBlock TextWrapping="Wrap" Text="This server was moved here from another PC without its source code, so it can't be updated yet. 'Make updatable' downloads the source of exactly the version it runs and compiles it once (30-90 minutes, needs the build tools from the Prerequisites page). After that it updates like any other server."/>
                <Button x:Name="BtnMakeUpdatable" Content="Make this server updatable..." HorizontalAlignment="Left" Margin="0,10,0,0"/>
              </StackPanel>
              <DataGrid x:Name="UpdGrid" MaxHeight="260" IsReadOnly="False">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="Update" Width="64">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate><CheckBox IsChecked="{Binding Include, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding HasChanges}" HorizontalAlignment="Center"/></DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Component" Binding="{Binding Name}" Width="2*" IsReadOnly="True"/>
                  <DataGridTextColumn Header="Installed" Binding="{Binding Current}" Width="2*" IsReadOnly="True"/>
                  <DataGridTextColumn Header="New" Binding="{Binding NewCommits}" Width="60" IsReadOnly="True"/>
                  <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="2*" IsReadOnly="True"/>
                  <DataGridTextColumn Header="Latest change" Binding="{Binding Latest}" Width="4*" IsReadOnly="True"/>
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock Style="{StaticResource StatLabel}" Text="CHANGES IN THE SELECTED COMPONENT" Margin="0,12,0,4"/>
              <TextBox x:Name="UpdChanges" IsReadOnly="True" Height="130" FontFamily="Consolas" FontSize="12" Background="#0D0F14"
                       VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto"/>
              <WrapPanel Margin="0,10,0,0">
                <TextBlock Text="Warn players" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="TxtUpdWarn" Width="50" Text="5" Margin="0,0,6,0"/>
                <TextBlock Text="minutes before the restart (only if the server is running)" VerticalAlignment="Center" Style="{StaticResource Muted}"/>
              </WrapPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource H2}" Text="Safety copies"/>
              <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                         Text="Every update keeps the previous version and a complete backup (characters and world) so you can go back. The newest two are kept automatically. Once you've played and everything is fine, you can delete them to free space."/>
              <DataGrid x:Name="SafetyGrid" MaxHeight="170">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Updated on" Binding="{Binding Date}" Width="2*"/>
                  <DataGridTextColumn Header="From" Binding="{Binding From}" Width="2*"/>
                  <DataGridTextColumn Header="To" Binding="{Binding To}" Width="2*"/>
                  <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="*"/>
                  <DataGridTextColumn Header="Size (MB)" Binding="{Binding SizeMB}" Width="*"/>
                </DataGrid.Columns>
              </DataGrid>
              <WrapPanel Margin="0,10,0,0">
                <Button x:Name="BtnRollback" Content="↶ Go back to the version before the selected update..."/>
                <Button x:Name="BtnSafetyDelete" Content="Delete selected"/>
                <Button x:Name="BtnSafetyDeleteAll" Style="{StaticResource Danger}" Content="Delete all safety copies..."/>
              </WrapPanel>
              <TextBlock x:Name="UpdHistory" Style="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource H2}" Text="Automatic updates"/>
              <WrapPanel>
                <CheckBox x:Name="ChkAutoUpdate" Content="Install updates automatically every" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="CmbAutoUpdateDay" Width="130" Margin="0,0,8,0"/>
                <TextBlock Text="at" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="TxtAutoUpdateTime" Width="70" Text="05:00" Margin="0,0,14,0"/>
                <Button x:Name="BtnAutoUpdateSave" Content="Save"/>
              </WrapPanel>
              <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"
                         Text="Only when no real player is online (bots don't count). If a module doesn't work with the new version yet, nothing is changed and it tries again next time. Problems after installing are rolled back by themselves. The PC must be on and you signed in."/>
              <CheckBox x:Name="ChkUpdPinned" Margin="0,12,0,0" Content="Pin this server to its current version (never update it, not even by hand)"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource H2}" Text="Modules"/>
              <TextBlock Style="{StaticResource Muted}" Text="Tick or untick features, then click Apply. The server is recompiled to add or remove them." Margin="0,0,0,8"/>
              <StackPanel x:Name="ModuleToggles"/>
              <Button x:Name="BtnModulesApply" Content="Apply module changes" HorizontalAlignment="Left" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource H2}" Text="Recompile"/>
              <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                         Text="Builds the server programs again from the version you have now (nothing is downloaded). Useful after repairs, after changing the build tools, or if the programs seem damaged. It uses the same safe steps as an update: compiles while the server keeps running, saves a safety copy, checks the result and puts everything back if something is wrong."/>
              <WrapPanel>
                <Button x:Name="BtnRecompile" Content="⟲  Recompile" ToolTip="Only recompiles what is needed (usually a few minutes)"/>
                <Button x:Name="BtnRecompileClean" Content="Clean recompile (from scratch)..." ToolTip="Fresh build folder, compiles everything (30-90 minutes). Fixes a damaged build."/>
              </WrapPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- ................................................. ADDONS -->
      <ScrollViewer x:Name="PageAddons" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
        <StackPanel>
          <TextBlock Style="{StaticResource H1}" Text="Game addons"/>
          <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,14"
                     Text="Companion addons for your game client that make the server's features easier to use. Installed into your game's Interface\AddOns folder. Restart WoW after installing."/>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource H2}" Text="Game folder"/>
              <DockPanel>
                <Button x:Name="BtnAddonGame" DockPanel.Dock="Right" Content="Change..." Margin="8,0,0,0"/>
                <TextBox x:Name="TxtAddonGame" IsReadOnly="True"/>
              </DockPanel>
            </StackPanel>
          </Border>
          <StackPanel x:Name="AddonList"/>
        </StackPanel>
      </ScrollViewer>

      <!-- ................................................. MY SERVERS -->
      <ScrollViewer x:Name="PageServers" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
        <StackPanel>
          <DockPanel Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="BtnSrvNew" Style="{StaticResource Primary}" Content="＋  New server"/>
              <Button x:Name="BtnSrvImport" Content="⇩  Import"/>
              <Button x:Name="BtnSrvAdd" Content="Add existing folder" Margin="0"/>
            </StackPanel>
            <StackPanel>
              <TextBlock Style="{StaticResource H1}" Text="My servers"/>
              <TextBlock x:Name="SrvSummary" Style="{StaticResource Muted}"/>
            </StackPanel>
          </DockPanel>
          <WrapPanel x:Name="ServerCards" Margin="-7,0,-7,0"/>
          <Border Style="{StaticResource Card}" Margin="0,10,0,14">
            <StackPanel>
              <TextBlock Style="{StaticResource H2}" Text="Storage"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <TextBlock Text="New servers go into" VerticalAlignment="Center"/>
                <DockPanel Grid.Column="1">
                  <Button x:Name="BtnPrefFolder" DockPanel.Dock="Right" Content="Change..." Margin="8,0,0,0"/>
                  <TextBox x:Name="TxtPrefFolder" IsReadOnly="True"/>
                </DockPanel>
                <TextBlock Grid.Row="1" Text="Map data" VerticalAlignment="Center" Margin="0,10,0,0"/>
                <CheckBox x:Name="ChkPrefShare" Grid.Row="1" Grid.Column="1" Margin="0,10,0,0"
                          Content="Share one copy of the map data between new servers (saves 3 GB per server)"/>
                <TextBlock Grid.Row="2" Text="Download cache" VerticalAlignment="Center" Margin="0,10,0,0"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
                  <TextBlock x:Name="TxtCacheSize" VerticalAlignment="Center" Margin="0,0,12,0" Style="{StaticResource Muted}"/>
                  <Button x:Name="BtnClearCache" Content="Clear cache"/>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- ................................................. EXPORT -->
      <ScrollViewer x:Name="PageExport" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
        <StackPanel>
          <TextBlock Style="{StaticResource H1}" Text="Export &amp; move"/>
          <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,14"
                     Text="Pack this server into one file to move it to another PC (e.g. a laptop), keep a portable copy, or share your setup. On the other PC: open this app, choose 'Import a server' and pick the file."/>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource H2}" Text="What to pack"/>
              <RadioButton x:Name="RbExpFull" GroupName="ExpKind" IsChecked="True">
                <TextBlock TextWrapping="Wrap"><Bold>Move this server</Bold> - the finished server, all settings and all data. The other PC does not need to compile anything (no Visual Studio, ready in minutes).</TextBlock>
              </RadioButton>
              <RadioButton x:Name="RbExpData" GroupName="ExpKind" Margin="0,8,0,4">
                <TextBlock TextWrapping="Wrap"><Bold>Characters and settings only</Bold> - a small file. The other PC builds a fresh server with the same settings (30-90 min) and loads your characters into it.</TextBlock>
              </RadioButton>
              <CheckBox x:Name="ChkExpMap" Margin="0,12,0,4" Content="Include the map data (+1.2 GB; otherwise the other PC downloads it)"/>
              <CheckBox x:Name="ChkExpSecrets" IsChecked="True"
                        Content="Include the server's admin passwords (needed for Stop/Console to work right away - keep the file private)"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource H2}" Text="Save to"/>
              <DockPanel>
                <Button x:Name="BtnExpFolder" DockPanel.Dock="Right" Content="Change..." Margin="8,0,0,0"/>
                <TextBox x:Name="TxtExpFolder" IsReadOnly="True"/>
              </DockPanel>
              <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" Text="Tip: save straight to a USB drive or a shared network folder to carry it over. Exporting works while the server runs."/>
              <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <Button x:Name="BtnExport" Style="{StaticResource Primary}" Content="⇪  Export now"/>
                <Button x:Name="BtnExpOpen" Content="Open export folder"/>
              </StackPanel>
              <TextBlock x:Name="ExpResult" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{StaticResource GoodBrush}"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- ................................................. IMPORT -->
      <ScrollViewer x:Name="PageImport" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
        <StackPanel>
          <TextBlock Style="{StaticResource H1}" Text="Import a server"/>
          <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,14"
                     Text="Bring in a server exported from another PC (a .wowserver file). Everything it needs to run is installed automatically."/>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource H2}" Text="1 · Choose the package"/>
              <DockPanel>
                <Button x:Name="BtnImpBrowse" DockPanel.Dock="Right" Content="Browse..." Margin="8,0,0,0"/>
                <TextBox x:Name="TxtImpFile" IsReadOnly="True"/>
              </DockPanel>
              <TextBlock x:Name="ImpInfo" Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="22"/>
            </StackPanel>
          </Border>
          <Border x:Name="ImpOptions" Style="{StaticResource Card}" IsEnabled="False">
            <StackPanel>
              <TextBlock Style="{StaticResource H2}" Text="2 · Where to put it on this PC"/>
              <DockPanel>
                <Button x:Name="BtnImpRoot" DockPanel.Dock="Right" Content="Change..." Margin="8,0,0,0"/>
                <TextBox x:Name="TxtImpRoot"/>
              </DockPanel>
              <TextBlock x:Name="ImpRootStatus" Margin="0,6,0,0" TextWrapping="Wrap"/>
              <TextBlock Style="{StaticResource H2}" Text="3 · Your WoW 3.3.5a game on this PC" Margin="0,16,0,8"/>
              <DockPanel>
                <Button x:Name="BtnImpWow" DockPanel.Dock="Right" Content="Browse..." Margin="8,0,0,0"/>
                <TextBox x:Name="TxtImpWow" IsReadOnly="True"/>
              </DockPanel>
              <TextBlock x:Name="ImpWowStatus" Margin="0,6,0,0" TextWrapping="Wrap" Style="{StaticResource Muted}"
                         Text="Optional - used to point the game at this server. You can set it later."/>
              <Button x:Name="BtnImport" Style="{StaticResource Primary}" Content="⇩  Import" HorizontalAlignment="Left" Margin="0,16,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- ................................................. PREREQUISITES -->
      <DockPanel x:Name="PagePrereqs" Visibility="Collapsed">
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Style="{StaticResource H1}" Text="Prerequisites"/>
          <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12"
                     Text="Everything this PC needs to build and run servers. New servers install what is missing automatically - this page lets you check, pre-install or repair them yourself."/>
          <Border Style="{StaticResource Card}">
            <WrapPanel>
              <Button x:Name="BtnPreAll" Style="{StaticResource Primary}" Content="Install everything missing"/>
              <Button x:Name="BtnPreRefresh" Content="Check again"/>
              <Button x:Name="BtnPreLinks" Content="Check download links"/>
              <CheckBox x:Name="ChkPreGuided" VerticalAlignment="Center" Margin="8,0,0,0"
                        Content="Guided mode (show each installer with instructions instead of installing silently)"/>
            </WrapPanel>
          </Border>
        </StackPanel>
        <TextBlock x:Name="PreFooter" DockPanel.Dock="Bottom" Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="PrereqList"/>
        </ScrollViewer>
      </DockPanel>

      <!-- ................................................. PERFORMANCE -->
      <ScrollViewer x:Name="PagePerformance" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
        <StackPanel>
          <TextBlock Style="{StaticResource H1}" Text="Performance"/>
          <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,14" TextWrapping="Wrap"
                     Text="How hard this PC is working, what uses its memory, and how many bots it can comfortably run. Updates every few seconds while this page is open."/>
          <UniformGrid Columns="4" Margin="-7,0,-7,0">
            <Border Style="{StaticResource Card}" Margin="7,0,7,14">
              <StackPanel><TextBlock Style="{StaticResource StatLabel}" Text="PROCESSOR"/><TextBlock x:Name="PerfCpu" Style="{StaticResource StatValue}" Text="–"/><TextBlock x:Name="PerfCpuHint" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/></StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="7,0,7,14">
              <StackPanel><TextBlock Style="{StaticResource StatLabel}" Text="MEMORY"/><TextBlock x:Name="PerfRam" Style="{StaticResource StatValue}" Text="–"/><TextBlock x:Name="PerfRamHint" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/></StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="7,0,7,14">
              <StackPanel><TextBlock Style="{StaticResource StatLabel}" Text="GRAPHICS MEMORY"/><TextBlock x:Name="PerfGpu" Style="{StaticResource StatValue}" Text="–"/><TextBlock x:Name="PerfGpuHint" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/></StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="7,0,7,14">
              <StackPanel><TextBlock Style="{StaticResource StatLabel}" Text="SERVER DRIVE"/><TextBlock x:Name="PerfDisk" Style="{StaticResource StatValue}" Text="–"/><TextBlock x:Name="PerfDiskHint" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/></StackPanel>
            </Border>
          </UniformGrid>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource H2}" Text="Your server's parts"/>
              <ItemsControl x:Name="PerfServer"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource H2}" Text="What else uses the most memory"/>
              <ItemsControl x:Name="PerfOthers"/>
              <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                         Text="Big programs here (games, browsers, other AI apps) compete with the server and the AI chatter for memory and graphics memory."/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource H2}" Text="How many bots?"/>
              <TextBlock x:Name="PerfAdvice" TextWrapping="Wrap" LineHeight="21"/>
              <Button x:Name="BtnPerfApply" Content="Use the suggested number" HorizontalAlignment="Left" Margin="0,10,0,0" Visibility="Collapsed"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- ................................................. LOGS -->
      <DockPanel x:Name="PageLogs" Visibility="Collapsed">
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Style="{StaticResource H1}" Text="Logs"/>
          <WrapPanel Margin="0,4,0,10">
            <ComboBox x:Name="LogFile" Width="260" Margin="0,0,10,0"/>
            <TextBox x:Name="LogFilter" Width="220" Margin="0,0,10,0" ToolTip="Show only lines containing this text"/>
            <Button x:Name="BtnLogRefresh" Content="Refresh"/>
            <CheckBox x:Name="ChkLogFollow" Content="Auto-refresh" VerticalAlignment="Center" Margin="6,0,0,0"/>
          </WrapPanel>
        </StackPanel>
        <TextBox x:Name="LogText" IsReadOnly="True" FontFamily="Consolas" FontSize="12" Background="#0D0F14"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
      </DockPanel>

      <!-- ................................................. ABOUT -->
      <ScrollViewer x:Name="PageAbout" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left">
          <TextBlock Style="{StaticResource H1}" Text="Help &amp; about"/>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                  <Button x:Name="BtnAppUpdate" Content="Check for app updates"/>
                  <Button x:Name="BtnAppSite" Content="Project page" Margin="0"/>
                </StackPanel>
                <StackPanel>
                  <TextBlock Style="{StaticResource H2}" Text="This app"/>
                  <TextBlock x:Name="TxtAppVersion" Style="{StaticResource Muted}"/>
                </StackPanel>
              </DockPanel>
              <TextBlock x:Name="TxtAppUpdate" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
              <Button x:Name="BtnAppDownload" Style="{StaticResource Primary}" Content="Download the new version" HorizontalAlignment="Left" Margin="0,10,0,0" Visibility="Collapsed"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <TextBlock x:Name="AboutText" TextWrapping="Wrap" LineHeight="22"/>
          </Border>
          <StackPanel Orientation="Horizontal">
            <Button x:Name="BtnAddExisting" Content="Add an existing server folder"/>
            <Button x:Name="BtnForget" Content="Remove selected server from this list"/>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <!-- ................................................. NEW SERVER WIZARD -->
      <DockPanel x:Name="PageWizard" Visibility="Collapsed">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
          <TextBlock x:Name="WizNote" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="WizBack" Content="Back"/>
            <Button x:Name="WizNext" Style="{StaticResource Primary}" Content="Next" Margin="0"/>
          </StackPanel>
        </DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
          <TextBlock x:Name="WizCrumb" Foreground="{StaticResource AccentBrush}" FontSize="12"/>
        </StackPanel>
        <Grid>
          <!-- W0 machine -->
          <ScrollViewer x:Name="Wiz0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Style="{StaticResource H1}" Text="Create a new server"/>
              <TextBlock Style="{StaticResource Muted}" FontSize="14" Margin="0,0,0,14"
                Text="This builds a complete Wrath of the Lich King (3.3.5a) server on this PC, filled with AI players who quest, level, trade and fight alongside you. Everything it needs is downloaded and installed automatically."/>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Style="{StaticResource H2}" Text="Your computer"/>
                  <TextBlock x:Name="SysInfo" TextWrapping="Wrap" LineHeight="22"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Style="{StaticResource H2}" Text="Before you start"/>
                  <TextBlock Style="{StaticResource Muted}" FontSize="14" LineHeight="22">
                    • You need the WoW 3.3.5a game client already on this PC.<LineBreak/>
                    • Allow about 1-2 hours. Most of it runs on its own.<LineBreak/>
                    • You need about 50 GB of free disk space and an internet connection.<LineBreak/>
                    • Windows may ask for permission a few times. Click Yes.
                  </TextBlock>
                </StackPanel>
              </Border>
              <Border x:Name="ResumeCard" Style="{StaticResource Card}" Background="#2B2516" BorderBrush="#6B5A2A" Visibility="Collapsed">
                <TextBlock x:Name="ResumeText" TextWrapping="Wrap"/>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <!-- W1 client + folder -->
          <ScrollViewer x:Name="Wiz1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel>
              <TextBlock Style="{StaticResource H1}" Text="Where are things?"/>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Style="{StaticResource H2}" Text="1 · Your World of Warcraft 3.3.5a game"/>
                  <TextBlock Style="{StaticResource Muted}" Text="Choose the Wow.exe file inside your game folder."/>
                  <DockPanel Margin="0,8,0,0">
                    <Button x:Name="BtnBrowseWow" DockPanel.Dock="Right" Content="Browse..." Margin="8,0,0,0"/>
                    <TextBox x:Name="TxtWow" IsReadOnly="True"/>
                  </DockPanel>
                  <TextBlock x:Name="WowStatus" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Style="{StaticResource H2}" Text="2 · Where to put the server"/>
                  <TextBlock Style="{StaticResource Muted}" Text="A new folder will be created here. Pick a drive with at least 50 GB free (an SSD is best). No spaces in the path."/>
                  <DockPanel Margin="0,8,0,0">
                    <Button x:Name="BtnBrowseRoot" DockPanel.Dock="Right" Content="Browse..." Margin="8,0,0,0"/>
                    <TextBox x:Name="TxtRoot"/>
                  </DockPanel>
                  <TextBlock x:Name="RootStatus" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <!-- W2 settings -->
          <ScrollViewer x:Name="Wiz2" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel>
              <TextBlock Style="{StaticResource H1}" Text="Choose how your world plays"/>
              <TextBlock Style="{StaticResource Muted}" Text="The defaults are a good starting point. Everything can be changed later in World settings." Margin="0,0,0,12"/>
              <StackPanel x:Name="WizSettingsForm"/>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Style="{StaticResource H2}" Text="Your game login"/>
                  <TextBlock Style="{StaticResource Muted}" Text="This is what you type on the WoW login screen. It only exists on your own server."/>
                  <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition MaxWidth="360"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <TextBlock Text="Username" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtUser" Grid.Column="1" MaxLength="17"/>
                    <TextBlock Grid.Row="1" Text="Password" VerticalAlignment="Center" Margin="0,8,0,0"/>
                    <PasswordBox x:Name="TxtPass" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" MaxLength="16"/>
                    <TextBlock Grid.Row="2" Text="Password again" VerticalAlignment="Center" Margin="0,8,0,0"/>
                    <PasswordBox x:Name="TxtPass2" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" MaxLength="16"/>
                    <CheckBox x:Name="ChkGm" Grid.Row="3" Grid.Column="1" Margin="0,10,0,0" IsChecked="True"
                              Content="Make me a Game Master (admin commands like .tele)"/>
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <!-- W3 install -->
          <DockPanel x:Name="Wiz3" Visibility="Collapsed">
            <StackPanel DockPanel.Dock="Top">
              <TextBlock x:Name="InstallTitle" Style="{StaticResource H1}" Text="Building your server"/>
              <TextBlock x:Name="InstallCurrent" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"/>
              <TextBlock x:Name="InstallDetail" Style="{StaticResource Muted}" Margin="0,4,0,0" MinHeight="18"/>
              <ProgressBar x:Name="InstallProgress" Height="10" Margin="0,10,0,4" Maximum="100"/>
              <TextBlock x:Name="InstallElapsed" Style="{StaticResource Muted}" Margin="0,0,0,10"/>
            </StackPanel>
            <Expander x:Name="LogExpander" DockPanel.Dock="Bottom" Header="Show technical details" Margin="0,8,0,0">
              <TextBox x:Name="LogBox" Height="200" IsReadOnly="True" FontFamily="Consolas" FontSize="12" Background="#0D0F14"
                       VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
            </Expander>
            <Border Style="{StaticResource Card}" Margin="0">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="StepList"/>
              </ScrollViewer>
            </Border>
          </DockPanel>

          <!-- W4 done -->
          <ScrollViewer x:Name="Wiz4" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel>
              <TextBlock Style="{StaticResource H1}" Text="Your server is ready!"/>
              <Border Style="{StaticResource Card}">
                <TextBlock x:Name="DoneText" TextWrapping="Wrap" LineHeight="24"/>
              </Border>
              <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnDoneStart" Style="{StaticResource Primary}" Content="Start the server now"/>
                <Button x:Name="BtnDoneDash" Content="Go to the dashboard"/>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </DockPanel>

      <!-- ................................................. BUSY OVERLAY -->
      <Border x:Name="Busy" Background="#E611131A" Visibility="Collapsed" Margin="-30,-24,-30,-18">
        <Border Style="{StaticResource Card}" Width="640" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="26">
          <StackPanel>
            <TextBlock x:Name="BusyTitle" Style="{StaticResource H2}" FontSize="18"/>
            <TextBlock x:Name="BusyDetail" Style="{StaticResource Muted}" MinHeight="18"/>
            <ProgressBar x:Name="BusyBar" Height="6" IsIndeterminate="True" Margin="0,14,0,14"/>
            <TextBox x:Name="BusyLog" Height="180" IsReadOnly="True" FontFamily="Consolas" FontSize="11" Background="#0D0F14"
                     VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
              <Button x:Name="BtnBusyCancel" Content="Cancel" Visibility="Collapsed"/>
              <Button x:Name="BtnBusyHide" Content="Keep using the app (runs in the background)" Visibility="Collapsed"/>
              <Button x:Name="BtnBusyClose" Content="Close" Visibility="Collapsed" Margin="0"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </Border>

      <!-- toast -->
      <Border x:Name="Toast" VerticalAlignment="Bottom" HorizontalAlignment="Right" Background="#262B38" BorderBrush="{StaticResource AccentDarkBrush}"
              BorderThickness="1" CornerRadius="8" Padding="16,10" Margin="0,0,0,4" Visibility="Collapsed" MaxWidth="520">
        <TextBlock x:Name="ToastText" TextWrapping="Wrap"/>
      </Border>
    </Grid>
  </Grid>
</Window>
