{
  "_comment": "Catalog for the 'Extra settings' window. Each item maps to one or more options in a server .conf file. Items whose file or option does not exist on a server (module not installed, option renamed) are hidden automatically. types: bool (on/off values, default 1/0), number (min/max), gold (stored as copper), choice (options [value,label]), ratio (two keys that add up to 100), flags (comma list, options [value,label]). 'keys' sets several options to the same value. minExpansion: 1 = TBC, 2 = WotLK.",
  "groups": [
    {
      "title": "Getting around",
      "icon": "🗺",
      "items": [
        {
          "file": "worldserver.conf",
          "key": "AllFlightPaths",
          "type": "bool",
          "label": "Every flight path is known from the start",
          "help": "New and existing characters can fly anywhere without discovering flight masters first."
        },
        {
          "file": "worldserver.conf",
          "key": "InstantFlightPaths",
          "type": "choice",
          "label": "Instant flights",
          "help": "Arrive immediately instead of watching the flight.",
          "options": [
            [
              "0",
              "Normal flights"
            ],
            [
              "1",
              "Always instant"
            ],
            [
              "2",
              "Instant, each player can switch it at the flight master"
            ]
          ]
        },
        {
          "file": "worldserver.conf",
          "key": "TaxiFlightSpeed",
          "type": "number",
          "min": 1,
          "max": 50,
          "label": "Flight speed",
          "help": "32 is the original speed; 50 is the maximum."
        },
        {
          "file": "worldserver.conf",
          "key": "Rate.MoveSpeed.Player",
          "type": "number",
          "min": 0.5,
          "max": 3,
          "label": "Running speed of players",
          "help": "1 = normal. Also speeds up mounts."
        },
        {
          "file": "worldserver.conf",
          "key": "PlayerStart.MapsExplored",
          "type": "bool",
          "label": "World map fully revealed for new characters"
        }
      ]
    },
